ENABLED_GAMES=valheim

VALHEIM_DIR=/opt/valheim
VALHEIM_SERVICE=valheim.service
VALHEIM_BACKUP_SERVICE=valheim-backup.service
VALHEIM_BACKUP_TIMER=valheim-backup.timer
VALHEIM_STEAMCMD=/opt/valheim/steamcmd/steamcmd.sh
VALHEIM_SERVER_DIR=/opt/valheim/server
VALHEIM_APP_ID=896660
VALHEIM_OWNER=valheim
VALHEIM_GROUP=valheim
VALHEIM_RCLONE_CONFIG=
VALHEIM_RCLONE_REMOTE=valheim-drive:
VALHEIM_STATUS_LOG_LINES=5000

# Fill these when the Minecraft runtime exists, then enable it in ENABLED_GAMES.
MINECRAFT_DIR=/opt/minecraft
MINECRAFT_SERVICE=minecraft.service
MINECRAFT_BACKUP_SERVICE=minecraft-backup.service
MINECRAFT_BACKUP_TIMER=minecraft-backup.timer
MINECRAFT_SERVER_DIR=/opt/minecraft/server
MINECRAFT_WORLD=world
MINECRAFT_RCLONE_REMOTE=minecraft-drive:
